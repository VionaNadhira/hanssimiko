# ==============================================================================
# Hanssimiko Bunker - Environment Template
#
# Copy this file to .env and fill in real values.
# NEVER commit a filled-in copy — .env is gitignored.
#
# This single file serves both:
#   - Foundry / CLI (DEPLOYER_PRIVATE_KEY, ZERO_G_RPC_URL, etc.)
#   - Next.js frontend (NEXT_PUBLIC_* variables, inlined at build time)
# ==============================================================================

# --- Smart Contract Deployment (server / CLI only — never sent to browser) ----

# Private key of the deployer EOA. 32-byte hex with 0x prefix.
DEPLOYER_PRIVATE_KEY=

# 0G Mainnet RPC endpoint for Foundry scripts.
ZERO_G_RPC_URL=https://evmrpc.0g.ai

# 0G Mainnet chain id. Do not change without changing the network itself.
ZERO_G_CHAIN_ID=16661

# 0G Mainnet block explorer base URL.
ZERO_G_EXPLORER_URL=https://chainscan.0g.ai

# Address of the deployed ZeroGLocker contract (used by Foundry verify).
ZERO_G_LOCKER_ADDRESS=

# Optional: only needed for forge verify-contract.
ZERO_G_EXPLORER_API_KEY=

# --- Next.js Frontend (NEXT_PUBLIC_* are browser-visible at build time) -------

# RPC endpoint for the frontend. Defaults to the public endpoint if unset.
NEXT_PUBLIC_ZERO_G_RPC_URL=https://evmrpc.0g.ai

# Must match the deployed contract address above.
NEXT_PUBLIC_ZERO_G_LOCKER_ADDRESS=

# WalletConnect Cloud project id (get one free at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Block number the contract was deployed at (for efficient log queries).
NEXT_PUBLIC_ZERO_G_DEPLOY_BLOCK=

# Canonical URL of your deployed frontend — NO trailing slash.
# WalletConnect Verify API compares this to the actual browser origin.
# A mismatch triggers "phishing" warnings in wallets. Set this to your Railway
# (or custom) domain before building, e.g. https://hanssimiko.up.railway.app
# Leave empty for local development (falls back to localhost:3000).
NEXT_PUBLIC_APP_URL=
